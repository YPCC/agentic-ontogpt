# =============================================================================
# agentic-ontogpt — Enterprise / Vertex AI + Application Default Credentials
# =============================================================================
# Copy to .env and fill in project values:
#   cp .env.adc.example .env
#
# Full guide: docs/AUTH_ADC.md
#
# Do NOT set GOOGLE_API_KEY / GEMINI_API_KEY in this mode.
# =============================================================================

# --- Vertex AI backend (required for ADC enterprise path) ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Model used by ADK LlmAgents (Path A / Path B)
ADK_LLM_MODEL=gemini-2.0-flash

# --- ADC source (choose one; do not commit real keys) ---
# Local dev: run  gcloud auth application-default login
# GCP runtime: attach a service account with roles/aiplatform.user
# Outside GCP (last resort):
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/to/sa-key.json

# Explicitly leave API-key vars empty / unset:
# GOOGLE_API_KEY=
# GEMINI_API_KEY=

# --- Other product secrets (unchanged) ---
BIOPORTAL_API_KEY=your_bioportal_api_key_here

# Optional: real OntoGPT SPIRES with OpenAI-compatible models
# OPENAI_API_KEY=
# SPIRES_LLM_MODEL=gpt-4o

# --- agentic-ontogpt controls ---
AGENTIC_ONTOGPT_MODE=real
# APPROVAL_MODE=auto
# APPROVAL_DIR=/tmp/agentic_ontogpt_approvals
# ONTOLOGY_POLICY_PATH=configs/ontology_policy.yaml
