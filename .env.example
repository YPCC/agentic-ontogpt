# Google / Gemini — developer API-key mode (AI Studio)
GOOGLE_API_KEY=your_google_api_key_here
# GEMINI_API_KEY=...   # alternative name some clients accept
#
# Enterprise: use Vertex AI + Application Default Credentials instead of API keys.
#   cp .env.adc.example .env
#   see docs/AUTH_ADC.md

# BioPortal (required for ontology recommendation & search)
# Get a free key: https://bioportal.bioontology.org/account
BIOPORTAL_API_KEY=your_bioportal_api_key_here

# Optional – real OntoGPT SPIRESEngine (OpenAI-compatible)
# OPENAI_API_KEY=...
# or use runoak set-apikey -e openai <key>

# --- agentic-ontogpt execution controls (P0) ---
# real (default): require OntoGPT; failures return REAL_EXTRACTION_FAILED
# simulation: opt-in fixture only (CI / UI demos); never used as silent fallback
AGENTIC_ONTOGPT_MODE=real

# Model overrides
# ADK_LLM_MODEL=gemini-2.0-flash
# SPIRES_LLM_MODEL=gpt-4o

# Ontology policy (allow/deny + preferred-by-type): configs/ontology_policy.yaml
# ONTOLOGY_POLICY_PATH=configs/ontology_policy.yaml

# Human approval checkpoints: auto | require | reject
# APPROVAL_MODE=auto
# APPROVAL_DIR=/tmp/agentic_ontogpt_approvals
