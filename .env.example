# Google / Gemini (required for ADK LlmAgents)
GOOGLE_API_KEY=your_google_api_key_here

# BioPortal (required for ontology recommendation & search)
BIOPORTAL_API_KEY=your_bioportal_api_key_here

# Optional – real OntoGPT SPIRESEngine
# OPENAI_API_KEY=...

# agentic-ontogpt execution controls
# real (default): failures return REAL_EXTRACTION_FAILED
# simulation: opt-in fixture only — never silent fallback
AGENTIC_ONTOGPT_MODE=real

# ADK_LLM_MODEL=gemini-2.0-flash
# SPIRES_LLM_MODEL=gpt-4o

# Ontology policy path (default: configs/ontology_policy.yaml)
# ONTOLOGY_POLICY_PATH=configs/ontology_policy.yaml
